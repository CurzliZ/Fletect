# Flood Sentry Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials)

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Persistence
DATABASE_PATH=data/flood_sentry.db

# Model Artifacts
MODEL_PATH=artifacts/flood_risk_dnn.keras
SCALER_PATH=artifacts/flood_dnn_scaler.joblib
XGB_MODEL_PATH=artifacts/xgboost_flood_model.json
PREFER_MODEL=dnn

# Physical Sensor Calibration
DEFAULT_CHANNEL_CAPACITY_CM=100.0
TELEMETRY_FRESHNESS_THRESHOLD_SEC=60

# Operational Alerting
HYSTERESIS_MEDIUM_CONFIRMATION_SAMPLES=2
HYSTERESIS_HIGH_PERSISTENCE_INTERVAL=10
